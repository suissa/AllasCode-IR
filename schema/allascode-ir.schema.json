{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allascode.org/schema/allascode-ir-0.1.json",
  "title": "AllasCode IR v0.1",
  "type": "object",
  "required": ["irVersion", "system", "entities", "intents", "behaviors", "flows", "policies", "invariants", "constraints", "schemas", "tests", "unresolved", "diagnostics"],
  "properties": {
    "irVersion": { "const": "0.1" },
    "system": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "problem": { "type": "string" },
        "context": { "type": "string" },
        "objective": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "intents": { "type": "array", "items": { "$ref": "#/$defs/intent" } },
    "behaviors": { "type": "array", "items": { "$ref": "#/$defs/behavior" } },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "schemas": { "type": "array", "items": { "$ref": "#/$defs/schemaNode" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["sourceKind"],
      "properties": {
        "sourceKind": { "enum": ["allasdsl", "spec-kit", "openspec", "custom", "chat", "markdown", "json", "yaml"] },
        "sourceRef": { "type": "string" },
        "locator": { "type": "string" },
        "excerpt": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "canonicalLabel", "name", "state", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "canonicalLabel": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "state": { "enum": ["inferred", "suggested", "confirmed", "rejected"] },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" }, "minItems": 1 }
      }
    },
    "entity": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["properties", "relations"],
          "properties": {
            "properties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "required": { "type": "boolean" },
                  "description": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "target"],
                "properties": {
                  "name": { "type": "string" },
                  "target": { "type": "string" },
                  "cardinality": { "enum": ["one", "zero-or-one", "many", "one-or-many"] },
                  "description": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "intent": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["entities", "behaviors"],
          "properties": {
            "entities": { "type": "array", "items": { "type": "string" } },
            "behaviors": { "type": "array", "items": { "type": "string" } },
            "flow": { "type": "string" },
            "expectedResult": { "type": "string" }
          }
        }
      ]
    },
    "behavior": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["given", "when", "then", "mustNot"],
          "properties": {
            "entity": { "type": "string" },
            "given": { "type": "array", "items": { "type": "string" } },
            "when": { "type": "array", "items": { "type": "string" } },
            "then": { "type": "array", "items": { "type": "string" } },
            "mustNot": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "flow": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["steps"],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "description"],
                "properties": {
                  "id": { "type": "string" },
                  "description": { "type": "string" },
                  "invokes": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "rule": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["expression"],
          "properties": {
            "scope": { "type": "string" },
            "expression": { "type": "string" }
          }
        }
      ]
    },
    "schemaNode": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        { "type": "object", "required": ["definition"], "properties": { "definition": {} } }
      ]
    },
    "test": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["kind", "given", "when", "then", "mustNot"],
          "properties": {
            "kind": { "enum": ["behavior", "acceptance", "regression", "invariant", "conformance", "causal-chaos"] },
            "behavior": { "type": "string" },
            "given": { "type": "array", "items": { "type": "string" } },
            "when": { "type": "array", "items": { "type": "string" } },
            "then": { "type": "array", "items": { "type": "string" } },
            "mustNot": { "type": "array", "items": { "type": "string" } },
            "hidden": { "type": "boolean" }
          }
        }
      ]
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "question", "reason", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "relatedTo": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
